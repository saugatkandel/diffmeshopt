{
    "python.languageServer": "Pylance",
    "python.defaultInterpreterPath": "/workspace/diffmeshopt/.pixi/envs/default/bin/python",
    "python-env.workspaceSearchPaths": [
        "/workspace/diffmeshopt/.pixi/envs"
    ],
    "python.terminal.activateEnvInCurrentTerminal": true,
    "editor.formatOnSave": true,
    "remote.defaultExtensionsIfInstalledLocally": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "Google.geminicodeassist",
        "usernamehw.errorlens",
        "njpwerner.autodocstring",
        "tamasfe.even-better-toml",
        "ms-toolsai.vscode-jupyter-powertoys"
    ],
    "notebook.formatOnCellExecution": true,
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll.ruff": "explicit",
        "notebook.source.organizeImports.ruff": "explicit"
    }
}