{
    "python.languageServer": "Pylance",
    "python.defaultInterpreterPath": "/workspace/diffmeshopt/.pixi/envs/default/bin/python",
    "python.terminal.activateEnvInCurrentTerminal": false,
    "editor.formatOnSave": true,
    "remote.defaultExtensionsIfInstalledLocally": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "Google.geminicodeassist",
        "usernamehw.errorlens",
        "njpwerner.autodocstring",
        "tamasfe.even-better-toml",
        "ms-toolsai.vscode-jupyter-powertoys"
    ],
    "notebook.formatOnCellExecution": true,
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll.ruff": "explicit",
        "notebook.source.organizeImports.ruff": "explicit"
    },
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*",
        "**/data",
        "**/output",
    ],
    // Stops Pylance from digging into the library code to find types
    "python.analysis.useLibraryCodeForTypes": false,
    // Reduces the depth of the "look ahead" analysis
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.indexing": false,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.userFileIndexingLimit": 500,
    "files.watcherExclude": {
        "**/.pixi/**": true,
        "**/data/**": true,
        "**/output/**": true
    },
    "python.envFile": "${workspaceFolder}/.env",
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "python.analysis.persistAllIndices": false
}