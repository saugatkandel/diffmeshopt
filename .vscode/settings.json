{
    "python.analysis.persistAllIndices": true,
    // --- 2. FILE VISIBILITY ---
    "files.exclude": {
        "**/.pixi": true,
        "**/__pycache__": true
    },
    // --- 3. CORE PYTHON SETUP ---
    "python.languageServer": "Pylance",
    "python.defaultInterpreterPath": "/Users/saugat/code/diffmeshopt/.venv/bin/python",
    "python.terminal.activateEnvInCurrentTerminal": false,
    "python.envFile": "${workspaceFolder}/.env",
    // --- 4. FORMATTING & LINTING (Google/LLVM Style) ---
    "editor.formatOnSave": true,
    "notebook.formatOnCellExecution": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll.ruff": "explicit",
        "notebook.source.organizeImports.ruff": "explicit"
    },
    // --- 5. PYLANCE OPTIMIZATION ---
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.indexing": true,
    "python.analysis.userFileIndexingLimit": 2000,
    "python.analysis.useLibraryCodeForTypes": false,
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*",
        "**/data",
        "**/output",
        "**/.pixi"
    ],
    "python.analysis.packageIndexDepths": [
        {
            "name": "torch",
            "depth": 2
        },
        {
            "name": "matplotlib",
            "depth": 2
        },
        {
            "name": "",
            "depth": 1
        }
    ],
    "python.analysis.extraPaths": [],
    // --- 6. PERFORMANCE WATCHERS ---
    "files.watcherExclude": {
        "**/.pixi/**": true,
        "**/data/**": true,
        "**/output/**": true,
        "**/.*/**": true
    },
    // --- 7. EXTENSIONS ---
    "remote.defaultExtensionsIfInstalledLocally": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "usernamehw.errorlens",
        "njpwerner.autodocstring",
        "tamasfe.even-better-toml",
        "ms-toolsai.vscode-jupyter-powertoys"
    ],
    // Tells Jupyter to look for widget scripts in the extension itself
    "jupyter.widgetScriptSources": [
        "local"
    ],
    "ruff.format.preview": true,
    "ruff.lineLength": null,
    "notebook.defaultFormatter": "charliermarsh.ruff",
    "notebook.formatOnSave.enabled": true,
    "python.terminal.useEnvFile": true,
}