FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/bash

WORKDIR /workspace

# 1. Update and install CUDA 12.8 + Tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    wget curl git build-essential cuda-toolkit-12-8 && \
    rm -rf /var/lib/apt/lists/*

# 2. Install Pixi
RUN curl -fsSL https://pixi.sh/install.sh | bash && \
    mv /root/.pixi/bin/pixi /usr/local/bin/pixi

# 3. Pre-install the VS Code Server binary and Extensions 
# We install them to /opt/vscode-extensions so they are baked into the image
RUN curl -fsSL https://code-server.dev/install.sh | sh
RUN code-server --extensions-dir /opt/vscode-extensions \
    --install-extension ms-python.python \
    --install-extension ms-python.pylance \
    --install-extension charliermarsh.ruff \
    --install-extension tamasfe.even-better-toml \
    --install-extension google.gemini-vscode \
    --install-extension ms-toolsai.jupyter \
    --install-extension usernamehw.errorlens

# 4. Alias for the terminal
RUN echo 'alias code="code-server"' >> ~/.bashrc

# 3. Create the destination folder and LINK the extensions
# This ensures that when VS Code Desktop connects, it "sees" the baked-in extensions immediately
RUN mkdir -p /root/.vscode-server && \
    ln -s /opt/vscode-extensions /root/.vscode-server/extensions