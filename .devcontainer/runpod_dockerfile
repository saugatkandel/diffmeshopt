FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    SHELL=/bin/bash

# 1. System Tools + CUDA + code-server
# We install the code-server CLI here so it's baked into the system
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        wget curl git build-essential cuda-toolkit-12-8 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Pixi (Moved to /usr/local/bin for global access)
RUN curl -fsSL https://pixi.sh/install.sh | bash && \
    mv /root/.pixi/bin/pixi /usr/local/bin/pixi

# 4. Inject the Startup Hook
COPY .devcontainer/pre_start.sh /pre_start.sh
RUN chmod +x /pre_start.sh

WORKDIR /workspace
# RunPod's /start.sh will automatically trigger our /pre_start.sh

